{
  "$schema": "https://github.com/electron-userland/electron-builder/raw/refs/tags/v24.13.3/packages/app-builder-lib/scheme.json",
  "appId": "io.github.thecreator177.athosmodmanager",
  "includeSubNodeModules": false,
  "directories": {
    "buildResources": "./nsis",
    "app": "./build",
    "output": "../../../dist"
  },
  "win": {
    "target": "nsis",
    "icon": "nsis/icon.ico",
    "publish": [
      {
        "provider": "github",
        "owner": "theCreator177",
        "repo": "Athos-Mod-Manager",
        "private": false
      }
    ],
    "signingHashAlgorithms": ["sha256"],
    "rfc3161TimeStampServer": "http://timestamp.comodoca.com/rfc3161",
    "timeStampServer": "http://timestamp.comodoca.com",
    "executableName": "AthosModManager",
    "verifyUpdateCodeSignature": true
  },
  "nsis": {
    "perMachine": true,
    "runAfterFinish": true,
    "menuCategory": false,
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "uninstallDisplayName": "${productName}",
    "include": "./nsis/installer.nsh",
    "artifactName": "athos-mod-manager-setup-${version}.${ext}",
    "installerIcon": "nsis/icon.ico",
    "installerHeaderIcon": "nsis/icon.ico",
    "deleteAppDataOnUninstall": false
  },
  "linux": {
    "target": ["zip"],
    "icon": "../../../assets/images/vortex.png",
    "category": "Network;Development;Game;",
    "synopsis": "Mod Manager",
    "description": "An independently maintained, configurable Vortex fork.",
    "maintainer": "Tony",
    "mimeTypes": []
  },
  "extraResources": [
    "./temp/VC_redist.x64.exe",
    "./temp/windowsdesktop-runtime-win-x64.exe",
    "./nsis/**/*",
    {
      "from": "../../../locales",
      "to": "locales"
    }
  ],
  "files": [
    "**/*",
    "!node_modules/@nexusmods/fomod-installer-native/prebuilds/**",
    "!node_modules/@nexusmods/fomod-installer-native/bin/**",
    "!node_modules/@nexusmods/fomod-installer-native/src-native/**",
    "!node_modules/@nexusmods/fomod-installer-native/*.{h,lib,dll}",
    "!node_modules/@nexusmods/fomod-installer-native/build/*.{vcxproj,filters}",
    "!node_modules/@nexusmods/fomod-installer-native/build/Release/*.{exp,iobj,ipdb,lib,pdb}",
    "!node_modules/@nexusmods/fomod-installer-native/build/Release/obj/**"
  ],
  "asar": true,
  "asarUnpack": [
    "LICENSE.md",
    "bundledPlugins",
    "node_modules/7z-bin",
    "node_modules/bootstrap-sass/assets/stylesheets",
    "node_modules/json-socket",
    "node_modules/react-select/scss",
    "node_modules/@nexusmods/fomod-installer-ipc/dist/*.exe",
    "assets/dotnetprobe*",
    "assets/loot/**",
    "assets/*.exe",
    "assets/css/**",
    "**/*.node",
    "duckdb-extensions"
  ],
  "buildDependenciesFromSource": false,
  "npmRebuild": false,
  "productName": "Athos Mod Manager",
  "copyright": "Vortex contributors; fork modifications copyright 2026 Tony"
}
